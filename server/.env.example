# Configuración del Servidor
PORT=3000
NODE_ENV=development

# Configuración de MongoDB
# Para transacciones, MongoDB requiere un replica set.
# En desarrollo local, iniciar mongod con: mongod --replSet rs0 --dbpath ./data/db
# Luego inicializar el replica set: rs.initiate()
MONGODB_URI=mongodb://localhost:27017/cuenta_bancaria?replicaSet=rs0
MONGODB_DB_NAME=cuenta_bancaria

# Configuración de la Moneda
CURRENCY=PEN
CURRENCY_SYMBOL=S/
CURRENCY_DECIMALS=2